---
---

<header class="w-full sticky top-0 z-40 flex justify-between items-center px-4 sm:px-8 h-16 bg-surface-container-low/80 backdrop-blur-xl border-b border-outline-subtle">
  <!-- Mobile Brand -->
  <div class="flex items-center gap-2 lg:hidden">
    <div class="w-8 h-8 rounded-lg gradient-primary flex items-center justify-center">
      <span class="material-symbols-outlined text-[#0f1419] text-base">storefront</span>
    </div>
    <span class="font-headline font-extrabold text-primary text-lg">DownLabs</span>
  </div>

  <!-- Search (desktop) -->
  <div class="hidden lg:flex items-center gap-3 flex-1 max-w-md">
    <div class="relative w-full">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">search</span>
      <input
        type="text"
        placeholder="Buscar productos, cotizaciones..."
        class="w-full pl-10 pr-4 py-2.5 bg-surface-container rounded-xl border border-outline-subtle text-sm text-on-surface placeholder-on-surface-variant focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth"
      />
    </div>
  </div>

  <!-- Right Section -->
  <div class="flex items-center gap-2 sm:gap-4">
    <button id="btn-notifications" class="p-2 rounded-xl hover:bg-surface-container transition-smooth relative group">
      <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary text-xl">notifications</span>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-secondary rounded-full animate-pulse-dot"></span>
    </button>

    <div class="hidden sm:block h-6 w-px bg-outline-variant/30"></div>

    <div class="hidden sm:flex items-center gap-3">
      <div class="text-right">
        <p class="text-xs font-semibold text-on-surface" id="navbar-name">TechParts MX</p>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-wider">Proveedor</p>
      </div>
      <div class="w-9 h-9 rounded-full gradient-accent flex items-center justify-center ring-2 ring-primary/10">
        <span class="text-xs font-bold text-white" id="navbar-avatar">TP</span>
      </div>
    </div>
  </div>
</header>
