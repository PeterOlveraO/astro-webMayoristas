---
interface Props {
  activeNav?: string;
}
const { activeNav = 'dashboard' } = Astro.props;

const navItems = [
  { icon: 'space_dashboard',  label: 'Dashboard',    href: '/dashboard',                    key: 'dashboard' },
  { icon: 'inventory_2',      label: 'Mi Catálogo',  href: '/dashboard/catalogo',            key: 'catalogo'  },
  { icon: 'request_quote',    label: 'Cotizaciones', href: '/dashboard/cotizaciones',        key: 'cotizaciones' },
  { icon: 'history',          label: 'Historial',    href: '/dashboard/historial',           key: 'historial' },
];
---

<aside class="h-screen w-72 fixed left-0 top-0 flex flex-col bg-surface-container-low py-6 px-4 z-50 border-r border-outline-subtle">
  <!-- Brand -->
  <div class="mb-10 px-4">
    <div class="flex items-center gap-3 mb-1">
      <div class="w-10 h-10 rounded-xl gradient-primary flex items-center justify-center">
        <span class="material-symbols-outlined text-[#0f1419] text-xl">storefront</span>
      </div>
      <div>
        <h1 class="font-headline font-extrabold text-primary text-xl tracking-tight">DownLabs</h1>
        <p class="text-[10px] font-semibold text-on-surface-variant uppercase tracking-[0.2em]">Portal Proveedor</p>
      </div>
    </div>
  </div>

  <!-- Supplier Info Card -->
  <div class="mx-2 mb-8 p-4 rounded-xl glass-card-light">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full gradient-accent flex items-center justify-center shrink-0">
        <span class="text-white text-sm font-bold" id="sidebar-avatar">TP</span>
      </div>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-on-surface truncate" id="sidebar-name">TechParts MX</p>
        <p class="text-xs text-on-surface-variant flex items-center gap-1">
          <span class="material-symbols-outlined text-secondary text-xs">verified</span>
          Proveedor verificado
        </p>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 space-y-1 px-2">
    <p class="text-[10px] font-semibold text-on-surface-variant uppercase tracking-[0.2em] px-3 mb-3">Menú Principal</p>
    {navItems.map((item) =>
      item.key === activeNav ? (
        <a
          href={item.href}
          class="flex items-center gap-3 px-4 py-3 bg-primary/10 text-primary rounded-xl font-semibold transition-smooth border border-primary/20"
        >
          <span class="material-symbols-outlined text-xl">{item.icon}</span>
          <span class="font-body text-sm">{item.label}</span>
        </a>
      ) : (
        <a
          href={item.href}
          class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-primary hover:bg-primary/5 transition-smooth rounded-xl"
        >
          <span class="material-symbols-outlined text-xl">{item.icon}</span>
          <span class="font-body text-sm">{item.label}</span>
        </a>
      )
    )}
  </nav>

  <!-- Bottom Action -->
  <div class="px-2 pt-4 border-t border-outline-subtle">
    <a
      href="/logout"
      class="flex items-center gap-3 px-4 py-3 text-on-surface-variant hover:text-error hover:bg-error/5 transition-smooth rounded-xl"
    >
      <span class="material-symbols-outlined text-xl">logout</span>
      <span class="font-body text-sm">Cerrar Sesión</span>
    </a>
  </div>
</aside>
