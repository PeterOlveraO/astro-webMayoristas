---
import BaseLayout from '../layouts/BaseLayout.astro';
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:5145';
---

<BaseLayout title="Iniciar Sesión · DownLabs Proveedores">
  <div id="app-config" data-api-url={API_URL} style="display:none"></div>
  <div class="min-h-screen bg-surface flex items-center justify-center p-4 font-body relative overflow-hidden">
    
    <!-- Background effects -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary/5 rounded-full blur-[120px]"></div>
      <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-secondary/5 rounded-full blur-[120px]"></div>
    </div>

    <div class="w-full max-w-[440px] relative z-10">
      
      <!-- Brand -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl gradient-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[#0f1419] text-2xl">storefront</span>
          </div>
        </div>
        <h1 class="font-headline text-3xl font-extrabold text-on-surface tracking-tight">DownLabs</h1>
        <p class="text-on-surface-variant text-sm mt-1">Portal de Proveedores</p>
      </div>

      <!-- Login Card -->
      <div class="glass-card rounded-2xl overflow-hidden">
        <div class="p-8">
          <h2 class="text-on-surface text-xl font-bold mb-1">Bienvenido de nuevo</h2>
          <p class="text-on-surface-variant text-sm mb-8">Ingresa con tu correo y contraseña.</p>

          <!-- Error -->
          <div id="error-msg" style="display:none;" class="mb-4 p-3 rounded-xl bg-error-container/20 border border-error/20 text-error text-sm flex items-center gap-2">
            <span class="material-symbols-outlined text-base">error</span>
            <span id="error-text"></span>
          </div>

          <form id="login-form" class="flex flex-col gap-5">
            <!-- Email -->
            <div class="flex flex-col gap-1.5">
              <label class="text-on-surface-variant text-sm font-semibold">Correo electrónico</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">mail</span>
                <input id="login-email" type="email" required placeholder="tucorreo@empresa.com" class="w-full pl-10 pr-4 py-3 bg-surface-container border border-outline-subtle rounded-xl text-sm text-on-surface placeholder-on-surface-variant focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth" />
              </div>
            </div>

            <!-- Password -->
            <div class="flex flex-col gap-1.5">
              <label class="text-on-surface-variant text-sm font-semibold">Contraseña</label>
              <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-lg">lock</span>
                <input id="login-password" type="password" required minlength="6" placeholder="••••••••" class="w-full pl-10 pr-12 py-3 bg-surface-container border border-outline-subtle rounded-xl text-sm text-on-surface placeholder-on-surface-variant focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth" />
                <div class="absolute inset-y-0 right-0 pr-3 flex items-center cursor-pointer" onclick="(function(ev){ev.preventDefault();ev.stopPropagation();var p=document.getElementById('login-password');var i=document.getElementById('login-eye');if(p.type==='password'){p.type='text';i.textContent='visibility_off';}else{p.type='password';i.textContent='visibility';}}).call(this,event)">
                  <span id="login-eye" class="material-symbols-outlined text-lg text-on-surface-variant hover:text-primary">visibility</span>
                </div>
              </div>
            </div>

            <!-- Submit -->
            <button type="submit" id="btn-login" class="w-full gradient-primary text-[#0f1419] font-bold py-3.5 rounded-xl transition-smooth hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center gap-2 mt-2 hover:scale-[1.02] active:scale-[0.98]">
              <span id="btn-login-text">Iniciar Sesión</span>
              <span class="material-symbols-outlined text-lg" id="btn-login-icon">login</span>
            </button>
          </form>
        </div>

        <!-- Footer -->
        <div class="bg-surface-container/50 p-5 border-t border-outline-subtle text-center">
          <p class="text-sm text-on-surface-variant">
            ¿No tienes cuenta? <a href="/registro" class="text-primary font-semibold hover:underline">Regístrate aquí</a>
          </p>
        </div>
      </div>

      <p class="text-center text-[11px] text-on-surface-variant mt-6">
        Powered by <span class="text-primary font-semibold">DownLabs</span> · B2B Commerce Platform
      </p>
    </div>
  </div>
</BaseLayout>


<script is:inline>
  const API_URL = document.getElementById('app-config').dataset.apiUrl;

  function getCookie(name) {
    var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return m ? m[2] : '';
  }
  if (getCookie('proveedor_id') && getCookie('access_token')) {
  window.location.href = '/dashboard';
}

  document.getElementById('login-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var errorDiv = document.getElementById('error-msg');
    var errorText = document.getElementById('error-text');
    var btn = document.getElementById('btn-login');
    var btnText = document.getElementById('btn-login-text');
    var btnIcon = document.getElementById('btn-login-icon');

    var email = document.getElementById('login-email').value.trim();
    var password = document.getElementById('login-password').value;

    if (!email || !password) {
      errorDiv.style.display = 'flex';
      errorText.textContent = 'Ingresa tu correo y contraseña.';
      return;
    }

    errorDiv.style.display = 'none';
    btn.disabled = true;
    btnText.textContent = 'Ingresando...';
    btnIcon.textContent = 'progress_activity';
    btnIcon.style.animation = 'spin 1s linear infinite';

    try {
      var res = await fetch(API_URL + '/api/auth/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ email: email, password: password }),
      });

      var data = await res.json();
      console.log('Login response:', data);

      if (!res.ok || !data.success) {
        var msg = data.message || data.error || 'Error desconocido';
        if (msg.includes('Invalid') || msg.includes('incorrectos')) msg = 'Correo o contraseña incorrectos.';
        errorDiv.style.display = 'flex';
        errorText.textContent = msg;
        btn.disabled = false;
        btnText.textContent = 'Iniciar Sesión';
        btnIcon.textContent = 'login';
        btnIcon.style.animation = '';
        return;
      }

      var userData = data.data;
      var perfil = userData.perfil;
      var userId = userData.user_id;
      var userEmail = userData.email;
      var rol = userData.rol;
      var proveedorId = perfil.id_mayorista;
      var proveedorNombre = perfil.nombre_empresa || '';

      if (!proveedorId) {
        errorDiv.style.display = 'flex';
        errorText.textContent = 'Tu cuenta no está vinculada a un proveedor. Contacta a DownLabs si el problema persiste.';
        btn.disabled = false;
        btnText.textContent = 'Iniciar Sesión';
        btnIcon.textContent = 'login';
        btnIcon.style.animation = '';
        return;
      }

      document.cookie = 'proveedor_id=' + proveedorId + '; path=/; max-age=604800; SameSite=Lax';
      document.cookie = 'proveedor_nombre=' + encodeURIComponent(proveedorNombre) + '; path=/; max-age=604800; SameSite=Lax';
      document.cookie = 'proveedor_email=' + encodeURIComponent(userEmail) + '; path=/; max-age=604800; SameSite=Lax';
      document.cookie = 'proveedor_rol=' + rol + '; path=/; max-age=604800; SameSite=Lax';
      document.cookie = 'access_token=' + userData.access_token + '; path=/; max-age=604800; SameSite=Lax';

      window.location.href = '/dashboard';

    } catch (err) {
      console.error('Login error:', err);
      errorDiv.style.display = 'flex';
      errorText.textContent = 'Error de red. Verifica tu conexión.';
    }

    btn.disabled = false;
    btnText.textContent = 'Iniciar Sesión';
    btnIcon.textContent = 'login';
    btnIcon.style.animation = '';
  });
</script>

<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>
