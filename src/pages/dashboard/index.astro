---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { supabase } from '../../db/supabase';

// Auth guard
const proveedorId = Astro.cookies.get('proveedor_id')?.value;
if (!proveedorId) {
  return Astro.redirect('/');
}

// Fetch proveedor info
const { data: proveedor } = await supabase
  .from('mayoristas')
  .select('*')
  .eq('id_mayorista', proveedorId)
  .single();

if (!proveedor) {
  return Astro.redirect('/');
}

// Count products in catalog
const { count: totalProductos } = await supabase
  .from('catalogo_productos')
  .select('*', { count: 'exact', head: true })
  .eq('id_mayorista', proveedorId);

// Count pending quotations (sent to this supplier)
const { data: myProducts } = await supabase
  .from('catalogo_productos')
  .select('id_producto')
  .eq('id_mayorista', proveedorId);

const productIds = myProducts?.map((p: any) => p.id_producto) || [];

let cotPendientes = 0;
let cotRespondidas = 0;
let recentCotizaciones: any[] = [];

if (productIds.length > 0) {
  const { count: pendCount } = await supabase
    .from('cotizaciones_downlabs')
    .select('*', { count: 'exact', head: true })
    .in('id_producto', productIds)
    .eq('estado', 'enviada');
  cotPendientes = pendCount || 0;

  const { count: respCount } = await supabase
    .from('cotizaciones_downlabs')
    .select('*', { count: 'exact', head: true })
    .in('id_producto', productIds)
    .in('estado', ['aceptada', 'rechazada']);
  cotRespondidas = respCount || 0;

  // Recent quotations
  const { data: recientes } = await supabase
    .from('cotizaciones_downlabs')
    .select(`
      *,
      catalogo_productos (nombre_articulo, categoria, precio_mayorista, imagen_url),
      solicitudes_cotizacion (descripcion_articulo, nivel_urgencia, clientes (nombre_empresa))
    `)
    .in('id_producto', productIds)
    .order('created_at', { ascending: false })
    .limit(5);
  recentCotizaciones = recientes || [];
}

// Average product rating
const { data: ratings } = await supabase
  .from('ratings_productos')
  .select('calificacion, catalogo_productos!inner(id_mayorista)')
  .eq('catalogo_productos.id_mayorista', proveedorId);

const avgRating = ratings && ratings.length > 0
  ? (ratings.reduce((s: number, r: any) => s + r.calificacion, 0) / ratings.length).toFixed(1)
  : '—';
const totalRatings = ratings?.length || 0;

const initials = proveedor.nombre_empresa
  .split(' ')
  .map((w: string) => w[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const estadoBadge: Record<string, { classes: string; label: string }> = {
  pendiente: { classes: 'bg-tertiary/10 text-tertiary border-tertiary/20', label: 'Pendiente' },
  enviada:   { classes: 'bg-primary/10 text-primary border-primary/20', label: 'Pendiente' },
  aceptada:  { classes: 'bg-success/10 text-success border-success/20', label: 'Aceptada'  },
  rechazada: { classes: 'bg-error/10 text-error border-error/20', label: 'Rechazada' },
};

const urgencyBadge: Record<string, { classes: string; icon: string }> = {
  baja:  { classes: 'text-on-surface-variant', icon: 'arrow_downward' },
  media: { classes: 'text-tertiary', icon: 'remove' },
  alta:  { classes: 'text-error', icon: 'arrow_upward' },
};
---

<DashboardLayout title="Dashboard" activeNav="dashboard">
  <!-- Header -->
  <header class="mb-10">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2 animate-slide-up">Panel de Proveedor</p>
        <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight animate-slide-up stagger-1" style="opacity:0;">
          Hola, {proveedor.nombre_empresa.split(' ')[0]} 👋
        </h1>
        <p class="text-on-surface-variant font-body mt-1 animate-slide-up stagger-2" style="opacity:0;">
          Aquí tienes un resumen de la actividad de tu negocio.
        </p>
      </div>
      <div class="flex items-center gap-2 animate-slide-up stagger-2" style="opacity:0;">
        <span class="material-symbols-outlined text-on-surface-variant text-base">calendar_today</span>
        <span class="text-sm text-on-surface-variant">{new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' })}</span>
      </div>
    </div>
  </header>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-10">
    <!-- Products in Catalog -->
    <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover-glow transition-smooth animate-slide-up stagger-1" style="opacity:0;">
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-primary text-xl">inventory_2</span>
          </div>
        </div>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-1">{totalProductos || 0}</h2>
        <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Productos en Catálogo</p>
      </div>
      <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-smooth">
        <span class="material-symbols-outlined" style="font-size: 100px;">inventory_2</span>
      </div>
    </div>

    <!-- Pending Quotations -->
    <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover-glow transition-smooth animate-slide-up stagger-2" style="opacity:0;">
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-tertiary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-tertiary text-xl">pending_actions</span>
          </div>
          {cotPendientes > 0 && (
            <span class="px-2 py-0.5 rounded-full bg-tertiary/10 text-tertiary text-xs font-bold border border-tertiary/20 animate-pulse-dot">
              Requiere atención
            </span>
          )}
        </div>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-1">{String(cotPendientes).padStart(2, '0')}</h2>
        <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Cotizaciones Pendientes</p>
      </div>
      <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-smooth">
        <span class="material-symbols-outlined" style="font-size: 100px;">pending_actions</span>
      </div>
    </div>

    <!-- Responded -->
    <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover-glow transition-smooth animate-slide-up stagger-3" style="opacity:0;">
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-success/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-success text-xl">task_alt</span>
          </div>
        </div>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-1">{cotRespondidas}</h2>
        <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Cotizaciones Respondidas</p>
      </div>
      <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-smooth">
        <span class="material-symbols-outlined" style="font-size: 100px;">task_alt</span>
      </div>
    </div>

    <!-- Rating -->
    <div class="glass-card rounded-2xl p-6 relative overflow-hidden group hover-glow transition-smooth animate-slide-up stagger-4" style="opacity:0;">
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-4">
          <div class="w-10 h-10 rounded-xl bg-accent/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-accent text-xl">star</span>
          </div>
        </div>
        <h2 class="font-headline text-4xl font-bold text-on-surface mb-1">{avgRating}</h2>
        <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest">{totalRatings} Reseñas</p>
      </div>
      <div class="absolute -right-6 -bottom-6 opacity-5 group-hover:opacity-10 transition-smooth">
        <span class="material-symbols-outlined" style="font-size: 100px;">star</span>
      </div>
    </div>
  </div>

  <!-- Main Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Recent Quotations -->
    <div class="lg:col-span-8 animate-slide-up stagger-4" style="opacity:0;">
      <div class="flex justify-between items-end mb-6">
        <h3 class="font-headline text-xl font-bold text-on-surface">Actividad Reciente</h3>
        <a href="/dashboard/cotizaciones" class="text-primary font-semibold text-sm hover:underline flex items-center gap-1">
          Ver todas
          <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
      </div>

      {recentCotizaciones.length === 0 ? (
        <div class="glass-card rounded-2xl p-12 text-center">
          <span class="material-symbols-outlined text-5xl text-on-surface-variant mb-4">inbox</span>
          <p class="text-on-surface-variant font-medium">No hay cotizaciones recientes</p>
          <p class="text-sm text-on-surface-variant mt-1">Cuando los operadores seleccionen tus productos, las cotizaciones aparecerán aquí.</p>
        </div>
      ) : (
        <div class="space-y-3">
          {recentCotizaciones.map((cot: any, i: number) => {
            const badge = estadoBadge[cot.estado] || estadoBadge.pendiente;
            const prod = cot.catalogo_productos;
            const sol = cot.solicitudes_cotizacion;
            const urgency = sol ? urgencyBadge[sol.nivel_urgencia] || urgencyBadge.media : urgencyBadge.media;
            return (
              <a
                href="/dashboard/cotizaciones"
                class="glass-card rounded-xl p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover-glow transition-smooth"
              >
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center shrink-0 overflow-hidden">
                    {prod?.imagen_url ? (
                      <img src={prod.imagen_url} alt="" class="w-full h-full object-cover" />
                    ) : (
                      <span class="material-symbols-outlined text-on-surface-variant">shopping_bag</span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <h4 class="font-semibold text-on-surface text-sm truncate">{prod?.nombre_articulo || 'Producto'}</h4>
                    <p class="text-xs text-on-surface-variant mt-0.5">
                      {sol?.clientes?.nombre_empresa || 'Cliente'} · {cot.cantidad} uds
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-3 sm:text-right">
                  <div class="flex items-center gap-1" title={`Urgencia ${sol?.nivel_urgencia || 'media'}`}>
                    <span class={`material-symbols-outlined text-sm ${urgency.classes}`}>{urgency.icon}</span>
                  </div>
                  <span class={`inline-flex px-2.5 py-1 rounded-lg text-xs font-semibold border ${badge.classes}`}>
                    {badge.label}
                  </span>
                  <span class="text-xs text-on-surface-variant hidden sm:block">
                    {new Date(cot.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' })}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>

    <!-- Quick Actions Panel -->
    <div class="lg:col-span-4 animate-slide-up stagger-5" style="opacity:0;">
      <div class="glass-card rounded-2xl p-6 relative overflow-hidden">
        <div class="absolute -right-20 -top-20 w-40 h-40 bg-primary/5 rounded-full blur-[60px]"></div>
        <div class="relative z-10">
          <h3 class="font-headline text-lg font-bold text-on-surface mb-6">Acciones Rápidas</h3>

          <div class="space-y-3">
            <a href="/dashboard/catalogo" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-smooth group">
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-smooth">
                <span class="material-symbols-outlined text-primary text-lg">add_circle</span>
              </div>
              <div>
                <p class="text-sm font-semibold text-on-surface">Agregar Producto</p>
                <p class="text-xs text-on-surface-variant">Sube un nuevo artículo al catálogo</p>
              </div>
            </a>

            <a href="/dashboard/cotizaciones" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-smooth group">
              <div class="w-10 h-10 rounded-lg bg-tertiary/10 flex items-center justify-center group-hover:bg-tertiary/20 transition-smooth">
                <span class="material-symbols-outlined text-tertiary text-lg">request_quote</span>
              </div>
              <div>
                <p class="text-sm font-semibold text-on-surface">Revisar Cotizaciones</p>
                <p class="text-xs text-on-surface-variant">
                  {cotPendientes > 0 ? `${cotPendientes} pendientes por responder` : 'No hay pendientes'}
                </p>
              </div>
            </a>

            <a href="/dashboard/historial" class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-smooth group">
              <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center group-hover:bg-accent/20 transition-smooth">
                <span class="material-symbols-outlined text-accent text-lg">analytics</span>
              </div>
              <div>
                <p class="text-sm font-semibold text-on-surface">Ver Estadísticas</p>
                <p class="text-xs text-on-surface-variant">Analiza tu rendimiento</p>
              </div>
            </a>
          </div>
        </div>
      </div>

      <!-- Trust Level Card -->
      <div class="glass-card rounded-2xl p-6 mt-4">
        <div class="flex items-center justify-between mb-4">
          <h4 class="font-headline text-sm font-bold text-on-surface">Nivel de Confianza</h4>
          <span class="material-symbols-outlined text-secondary text-lg">verified</span>
        </div>
        <div class="flex items-center gap-1 mb-3">
          {[1, 2, 3, 4, 5].map((star) => (
            <span class={`material-symbols-outlined text-lg ${star <= (proveedor.nivel_confianza || 0) ? 'text-tertiary' : 'text-outline'}`} style={star <= (proveedor.nivel_confianza || 0) ? "font-variation-settings: 'FILL' 1;" : ""}>
              star
            </span>
          ))}
          <span class="text-sm text-on-surface-variant ml-2">{proveedor.nivel_confianza || 0}/5</span>
        </div>
        <p class="text-xs text-on-surface-variant">
          Este nivel lo asignan los operadores de DownLabs según tu historial de respuestas y calidad.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>
