---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../db/supabase';

const proveedorId = Astro.cookies.get('proveedor_id')?.value;
if (!proveedorId) return Astro.redirect('/');

// Get provider's products
const { data: myProducts } = await supabase
  .from('catalogo_productos')
  .select('id_producto')
  .eq('id_mayorista', proveedorId);

const productIds = myProducts?.map((p: any) => p.id_producto) || [];

let cotizaciones: any[] = [];
if (productIds.length > 0) {
  const { data } = await supabase
    .from('cotizaciones_downlabs')
    .select(`
      *,
      catalogo_productos (id_producto, nombre_articulo, categoria, precio_mayorista, imagen_url, moq),
      solicitudes_cotizacion (
        id_solicitud,
        descripcion_articulo,
        especificaciones_req,
        nivel_urgencia,
        estado_solicitud,
        created_at,
        clientes (nombre_empresa, correo_contacto)
      )
    `)
    .in('id_producto', productIds)
    .eq('estado', 'enviada')
    .order('created_at', { ascending: false });
  cotizaciones = data || [];
}

// Group by solicitud
const grouped: Record<string, { solicitud: any; items: any[] }> = {};
for (const cot of cotizaciones) {
  const solId = cot.solicitudes_cotizacion?.id_solicitud || cot.id_cotizacion;
  if (!grouped[solId]) {
    grouped[solId] = {
      solicitud: cot.solicitudes_cotizacion,
      items: []
    };
  }
  grouped[solId].items.push(cot);
}

const groups = Object.entries(grouped);

const urgencyConfig: Record<string, { label: string; classes: string; icon: string }> = {
  baja:  { label: 'Baja',  classes: 'bg-success/10 text-success border-success/20', icon: 'arrow_downward' },
  media: { label: 'Media', classes: 'bg-tertiary/10 text-tertiary border-tertiary/20', icon: 'remove' },
  alta:  { label: 'Alta',  classes: 'bg-error/10 text-error border-error/20', icon: 'arrow_upward' },
};
---

<DashboardLayout title="Cotizaciones Recibidas" activeNav="cotizaciones">
  <header class="mb-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">Cotizaciones</p>
        <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight">
          Cotizaciones Recibidas
        </h1>
        <p class="text-on-surface-variant font-body mt-1">
          {cotizaciones.length} producto{cotizaciones.length !== 1 ? 's' : ''} en {groups.length} solicitud{groups.length !== 1 ? 'es' : ''} pendiente{groups.length !== 1 ? 's' : ''}
        </p>
      </div>
    </div>
  </header>

  {groups.length === 0 ? (
    <div class="glass-card rounded-2xl p-16 text-center">
      <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">mark_email_read</span>
      <h3 class="text-xl font-bold text-on-surface mb-2">No hay cotizaciones pendientes</h3>
      <p class="text-on-surface-variant">Cuando los operadores incluyan tus productos en cotizaciones, aparecerán aquí.</p>
    </div>
  ) : (
    <div class="space-y-6">
      {groups.map(([solId, group], groupIdx) => {
        const sol = group.solicitud;
        const urgency = urgencyConfig[sol?.nivel_urgencia || 'media'];
        return (
          <div class={`glass-card rounded-2xl overflow-hidden animate-slide-up stagger-${Math.min(groupIdx + 1, 6)}`} style="opacity:0;">
            <!-- Solicitud Header -->
            <div class="p-5 sm:p-6 border-b border-outline-subtle">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-primary text-xl">request_quote</span>
                  </div>
                  <div>
                    <h3 class="font-bold text-on-surface text-base">
                      Solicitud: {sol?.descripcion_articulo || 'Sin descripción'}
                    </h3>
                    <p class="text-sm text-on-surface-variant mt-0.5">
                      Cliente: <span class="text-on-surface font-medium">{sol?.clientes?.nombre_empresa || 'N/A'}</span>
                    </p>
                    <p class="text-xs text-on-surface-variant mt-1">
                      {sol?.created_at ? new Date(sol.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' }) : ''}
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class={`inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold border ${urgency.classes}`}>
                    <span class="material-symbols-outlined text-xs">{urgency.icon}</span>
                    Urgencia {urgency.label}
                  </span>
                  <span class="px-3 py-1.5 rounded-lg bg-primary/10 text-primary text-xs font-semibold border border-primary/20">
                    {group.items.length} producto{group.items.length !== 1 ? 's' : ''}
                  </span>
                </div>
              </div>
              {sol?.especificaciones_req && (
                <div class="mt-4 p-3 rounded-xl bg-surface-container text-sm text-on-surface-variant">
                  <span class="font-semibold text-on-surface-variant">Especificaciones: </span>
                  {typeof sol.especificaciones_req === 'object' ? JSON.stringify(sol.especificaciones_req) : sol.especificaciones_req}
                </div>
              )}
            </div>

            <!-- Products in this quotation -->
            <div class="divide-y divide-outline-subtle">
              {group.items.map((cot: any) => {
                const prod = cot.catalogo_productos;
                return (
                  <div class="p-5 sm:p-6 cotizacion-item" data-cot-id={cot.id_cotizacion} data-sol-id={solId}>
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                      <!-- Product Info -->
                      <div class="flex items-center gap-4 flex-1">
                        <div class="w-16 h-16 rounded-xl bg-surface-container flex items-center justify-center shrink-0 overflow-hidden">
                          {prod?.imagen_url ? (
                            <img src={prod.imagen_url} alt="" class="w-full h-full object-cover" />
                          ) : (
                            <span class="material-symbols-outlined text-on-surface-variant text-2xl">shopping_bag</span>
                          )}
                        </div>
                        <div class="min-w-0">
                          <h4 class="font-bold text-on-surface">{prod?.nombre_articulo || 'Producto'}</h4>
                          <p class="text-sm text-on-surface-variant">{prod?.categoria}</p>
                          <div class="flex items-center gap-4 mt-1">
                            <span class="text-xs text-on-surface-variant">
                              Precio catálogo: <span class="text-on-surface font-semibold">${Number(prod?.precio_mayorista || 0).toLocaleString('es-MX', { minimumFractionDigits: 2 })}</span>
                            </span>
                            <span class="text-xs text-on-surface-variant">
                              Cantidad: <span class="text-on-surface font-semibold">{cot.cantidad} uds</span>
                            </span>
                            <span class="text-xs text-on-surface-variant">
                              MOQ: <span class="text-on-surface font-semibold">{prod?.moq || 1}</span>
                            </span>
                          </div>
                        </div>
                      </div>

                      <!-- Operator notes -->
                      {cot.notas_operador && (
                        <div class="lg:max-w-[200px] p-3 rounded-xl bg-surface-container text-xs text-on-surface-variant">
                          <span class="font-semibold text-on-surface-variant flex items-center gap-1 mb-1">
                            <span class="material-symbols-outlined text-xs">comment</span> Nota del operador
                          </span>
                          {cot.notas_operador}
                        </div>
                      )}
                    </div>

                    <!-- Response Form -->
                    <div class="mt-4 p-4 rounded-xl bg-surface-container border border-outline-subtle">
                      <p class="text-sm font-semibold text-on-surface mb-3 flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-base">edit_note</span>
                        Tu Respuesta
                      </p>
                      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
                        <div class="flex flex-col gap-1">
                          <label class="text-xs text-on-surface-variant font-semibold">Precio Final</label>
                          <div class="relative">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xs font-semibold">$</span>
                            <input
                              type="number"
                              step="0.01"
                              min="0"
                              value={prod?.precio_mayorista}
                              class="input-precio w-full pl-7 pr-3 py-2.5 bg-surface-container-low border border-outline-subtle rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary/40 transition-smooth"
                            />
                          </div>
                        </div>
                        <div class="flex flex-col gap-1">
                          <label class="text-xs text-on-surface-variant font-semibold">Tiempo de Entrega</label>
                          <div class="relative">
                            <input
                              type="number"
                              min="1"
                              value="5"
                              class="input-entrega w-full px-3 py-2.5 bg-surface-container-low border border-outline-subtle rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary/40 transition-smooth"
                            />
                            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xs">días</span>
                          </div>
                        </div>
                        <div class="flex flex-col gap-1">
                          <label class="text-xs text-on-surface-variant font-semibold">Disponible</label>
                          <select class="input-disponible w-full px-3 py-2.5 bg-surface-container-low border border-outline-subtle rounded-lg text-sm text-on-surface focus:outline-none focus:border-primary/40 transition-smooth appearance-none">
                            <option value="true">Sí, disponible</option>
                            <option value="false">No disponible</option>
                          </select>
                        </div>
                      </div>
                      <div class="flex flex-col gap-1 mb-4">
                        <label class="text-xs text-on-surface-variant font-semibold">Notas para el operador</label>
                        <textarea
                          class="input-notas w-full px-3 py-2.5 bg-surface-container-low border border-outline-subtle rounded-lg text-sm text-on-surface placeholder-on-surface-variant focus:outline-none focus:border-primary/40 transition-smooth resize-none"
                          rows="2"
                          placeholder="Ej: Tenemos 200 unidades en stock, entrega express disponible..."
                        ></textarea>
                      </div>
                      <div class="flex items-center gap-3">
                        <button
                          class="btn-accept flex-1 gradient-primary text-[#0f1419] py-2.5 rounded-xl font-bold text-sm hover:shadow-lg hover:shadow-primary/20 transition-smooth flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-[0.98]"
                          data-cot-id={cot.id_cotizacion}
                        >
                          <span class="material-symbols-outlined text-base">check_circle</span>
                          Aceptar Cotización
                        </button>
                        <button
                          class="btn-reject py-2.5 px-6 rounded-xl border border-error/30 text-error font-bold text-sm hover:bg-error/10 transition-smooth flex items-center justify-center gap-2"
                          data-cot-id={cot.id_cotizacion}
                        >
                          <span class="material-symbols-outlined text-base">cancel</span>
                          Rechazar
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  )}
</DashboardLayout>

<script>
  import { supabase } from '../../../db/supabase';

  // Accept quotation
  document.querySelectorAll('.btn-accept').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const cotId = el.dataset.cotId;
      const container = el.closest('.cotizacion-item') as HTMLElement;
      const solId = container?.dataset.solId;

      const precio = (container?.querySelector('.input-precio') as HTMLInputElement)?.value;
      const entrega = (container?.querySelector('.input-entrega') as HTMLInputElement)?.value;
      const disponible = (container?.querySelector('.input-disponible') as HTMLSelectElement)?.value;
      const notas = (container?.querySelector('.input-notas') as HTMLTextAreaElement)?.value;

      el.disabled = true;
      el.innerHTML = '<span class="material-symbols-outlined animate-spin text-base">progress_activity</span> Procesando...';

      const { error } = await supabase
        .from('cotizaciones_downlabs')
        .update({
          estado: 'aceptada',
          precio_proveedor_final: parseFloat(precio) || null,
          disponibilidad: disponible === 'true',
          tiempo_entrega_dias: parseInt(entrega) || null,
          notas_proveedor: notas || null,
          respondido_at: new Date().toISOString(),
        })
        .eq('id_cotizacion', cotId);

      if (error) {
        alert('Error: ' + error.message);
        el.disabled = false;
        el.innerHTML = '<span class="material-symbols-outlined text-base">check_circle</span> Aceptar Cotización';
        return;
      }

      // Check if all items in this solicitud are responded
      await checkAndUpdateSolicitud(solId);
      window.location.reload();
    });
  });

  // Reject quotation
  document.querySelectorAll('.btn-reject').forEach(btn => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLButtonElement;
      const cotId = el.dataset.cotId;
      const container = el.closest('.cotizacion-item') as HTMLElement;
      const solId = container?.dataset.solId;

      const notas = (container?.querySelector('.input-notas') as HTMLTextAreaElement)?.value;

      el.disabled = true;
      el.innerHTML = '<span class="material-symbols-outlined animate-spin text-base">progress_activity</span>';

      const { error } = await supabase
        .from('cotizaciones_downlabs')
        .update({
          estado: 'rechazada',
          disponibilidad: false,
          notas_proveedor: notas || 'Rechazada por el proveedor',
          respondido_at: new Date().toISOString(),
        })
        .eq('id_cotizacion', cotId);

      if (error) {
        alert('Error: ' + error.message);
        el.disabled = false;
        el.innerHTML = '<span class="material-symbols-outlined text-base">cancel</span> Rechazar';
        return;
      }

      await checkAndUpdateSolicitud(solId);
      window.location.reload();
    });
  });

  // Check if all cotizaciones for a solicitud are responded
  async function checkAndUpdateSolicitud(solId: string | undefined) {
    if (!solId) return;

    const { data: allCots } = await supabase
      .from('cotizaciones_downlabs')
      .select('estado')
      .eq('id_solicitud', solId);

    if (!allCots) return;

    const allResponded = allCots.every((c: any) => c.estado === 'aceptada' || c.estado === 'rechazada');

    if (allResponded) {
      await supabase
        .from('solicitudes_cotizacion')
        .update({
          estado_solicitud: 'respondida',
          updated_at: new Date().toISOString(),
        })
        .eq('id_solicitud', solId);
    }
  }
</script>
