---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;

// Auth guard blindado
const proveedorId = 
  Astro.cookies.get('id_mayorista')?.value ?? 
  Astro.cookies.get('proveedor_id')?.value;

if (!proveedorId || proveedorId === 'undefined' || proveedorId === 'null') {
  return Astro.redirect('/');
}

async function safeFetch(url: string) {
  try {
    const res = await fetch(url);
    const text = await res.text();
    if (!text || text.trim() === '') return { success: false, data: null };
    return JSON.parse(text);
  } catch {
    return { success: false, data: null };
  }
}

// Fetch con el ID ya validado
const result = await safeFetch(
  `${API_URL}/api/solicitudes-mayorista?id_mayorista=${proveedorId}&estado=pendiente&pageSize=100`
);
const solicitudes: any[] = result.data ?? [];
---

<DashboardLayout title="Solicitudes Pendientes" activeNav="solicitudes">

  <!-- Header -->
  <header class="mb-8">
    <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">Por Responder</p>
    <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight">
      Solicitudes Pendientes
    </h1>
    <p class="text-on-surface-variant font-body mt-1">
      {solicitudes.length} solicitud{solicitudes.length !== 1 ? 'es' : ''} esperando tu respuesta
    </p>
  </header>

  <!-- Lista -->
  {solicitudes.length === 0 ? (
    <div class="glass-card rounded-2xl p-16 text-center">
      <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">inbox</span>
      <h3 class="text-xl font-bold text-on-surface mb-2">Sin solicitudes pendientes</h3>
      <p class="text-on-surface-variant">
        Cuando los operadores te incluyan en cotizaciones, aparecerán aquí.
      </p>
    </div>
  ) : (
    <div class="flex flex-col gap-4" id="solicitudes-lista">
      {solicitudes.map((sol: any) => {
        const productos: any[] = Array.isArray(sol.productos) ? sol.productos : [];
        const fecha = sol.created_at
          ? new Date(sol.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' })
          : '';

        return (
          <div
            class="glass-card rounded-2xl overflow-hidden"
            data-id={sol.id_solicitud_mayorista}
          >
            <!-- Card header -->
            <div class="p-5 border-b border-outline-subtle flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-primary text-xl">request_quote</span>
                </div>
                <div>
                  <p class="font-semibold text-on-surface text-sm">
                    Solicitud #{sol.id_solicitud_mayorista?.toString().slice(0, 8).toUpperCase()}
                  </p>
                  <p class="text-xs text-on-surface-variant">{fecha}</p>
                </div>
              </div>
              <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-warning/10 text-warning border border-warning/20 self-start sm:self-auto">
                <span class="material-symbols-outlined text-xs">schedule</span>
                Pendiente
              </span>
            </div>

            <!-- Productos solicitados -->
            <div class="p-5">
              {productos.length > 0 ? (
                <div class="mb-4">
                  <p class="text-xs text-on-surface-variant uppercase tracking-widest mb-2 font-semibold">
                    Productos solicitados
                  </p>
                  <div class="flex flex-col gap-2">
                    {productos.map((p: any) => (
                      <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-surface-container border border-outline-subtle">
                        <div class="flex items-center gap-2">
                          <span class="material-symbols-outlined text-on-surface-variant text-base">package_2</span>
                          <span class="text-sm text-on-surface font-medium">
                            {typeof p === 'string' ? p : (p.nombre ?? p.nombre_articulo ?? 'Producto')}
                          </span>
                        </div>
                        {(p.cantidad || p.qty) && (
                          <span class="text-xs font-semibold text-on-surface-variant">
                            ×{p.cantidad ?? p.qty}
                          </span>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <p class="text-sm text-on-surface-variant mb-4">Sin detalle de productos.</p>
              )}

              {sol.notas_operador && (
                <div class="mb-4 p-3 rounded-xl bg-surface-container border border-outline-subtle">
                  <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest mb-1">
                    Nota del operador
                  </p>
                  <p class="text-sm text-on-surface">{sol.notas_operador}</p>
                </div>
              )}

              <!-- Formulario de respuesta -->
              <div class="border-t border-outline-subtle pt-4 mt-2">
                <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-widest mb-3 flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">edit_note</span>
                  Tu Respuesta
                </p>
                <form
                  class="respuesta-form flex flex-col gap-3"
                  data-id={sol.id_solicitud_mayorista}
                >
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="flex flex-col gap-1">
                      <label class="text-xs font-semibold text-on-surface-variant">
                        Costo de envio ($) *
                      </label>
                      <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-sm font-semibold">$</span>
                        <input
                          type="number" step="0.01" min="0" required
                          name="precio"
                          placeholder="0.00"
                          class="w-full pl-8 pr-4 py-2.5 bg-surface-container border border-outline-subtle rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth"
                        />
                      </div>
                    </div>
                    <div class="flex flex-col gap-1">
                      <label class="text-xs font-semibold text-on-surface-variant">
                        Tiempo de Entrega (días)
                      </label>
                      <input
                        type="number" min="1" name="tiempo_entrega"
                        placeholder="Ej: 5"
                        class="w-full px-4 py-2.5 bg-surface-container border border-outline-subtle rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth"
                      />
                    </div>
                  </div>

                  <div class="flex flex-col gap-1">
                    <label class="text-xs font-semibold text-on-surface-variant">
                      Notas adicionales
                    </label>
                    <textarea
                      name="notas" rows="2"
                      placeholder="Condiciones, disponibilidad, descuentos..."
                      class="w-full px-4 py-2.5 bg-surface-container border border-outline-subtle rounded-xl text-sm text-on-surface focus:outline-none focus:border-primary/40 focus:ring-1 focus:ring-primary/20 transition-smooth resize-none"
                    ></textarea>
                  </div>

                  <div class="form-error hidden p-3 rounded-xl bg-error/10 border border-error/20 text-error text-sm flex items-center gap-2">
                    <span class="material-symbols-outlined text-base">error</span>
                    <span class="form-error-text"></span>
                  </div>

                  <div class="flex gap-2">
                    <button
                      type="submit" name="accion" value="aceptada"
                      class="flex-1 gradient-primary text-[#0f1419] font-bold py-2.5 rounded-xl text-sm flex items-center justify-center gap-1.5 hover:shadow-lg hover:shadow-primary/20 transition-smooth"
                    >
                      <span class="material-symbols-outlined text-base">check_circle</span>
                      Aceptar
                    </button>
                    <button
                      type="submit" name="accion" value="rechazada"
                      class="flex-1 py-2.5 rounded-xl border border-error/30 text-error font-semibold text-sm flex items-center justify-center gap-1.5 hover:bg-error/10 transition-smooth"
                    >
                      <span class="material-symbols-outlined text-base">cancel</span>
                      Rechazar
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</DashboardLayout>

<div id="app-config" data-api-url={API_URL} style="display:none;"></div>

<input type="hidden" id="__proveedor_id" value={proveedorId} />
<div id="app-config" data-api-url={API_URL} style="display:none;"></div>

<script is:inline>
  var API_URL = document.getElementById('app-config').dataset.apiUrl;
  var proveedorId = document.getElementById('__proveedor_id').value;

  document.querySelectorAll('.respuesta-form').forEach(function(form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      var accion = e.submitter?.value || 'aceptada';
      var solId = form.dataset.id;
      var precio = parseFloat(form.querySelector('[name="precio"]').value);
      var tiempoEntrega = parseInt(form.querySelector('[name="tiempo_entrega"]').value) || null;
      var notas = form.querySelector('[name="notas"]').value.trim() || null;

      var errorDiv = form.querySelector('.form-error');
      var errorText = form.querySelector('.form-error-text');

      if (isNaN(precio) || precio <= 0) {
        errorDiv.classList.remove('hidden');
        errorText.textContent = 'El precio final es obligatorio.';
        return;
      }

      errorDiv.classList.add('hidden');
      var btns = form.querySelectorAll('button[type="submit"]');
      btns.forEach(function(b) { b.disabled = true; });

      try {
        var res = await fetch(API_URL + '/api/solicitudes-mayorista/' + solId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id_mayorista: proveedorId, // Mandamos el ID real validado
            estado: accion,
            costo_envio: precio,
            tiempo_entrega_dias: tiempoEntrega,
            notas_mayorista: notas,
            respondido_at: new Date().toISOString()
          })
        });

        if (!res.ok) {
          var err = await res.json().catch(function() { return {}; });
          throw new Error(err.message || 'Error ' + res.status);
        }

        // Animación de salida de la card
        var card = form.closest('[data-id="' + solId + '"]');
        if (card) {
          card.style.transition = 'opacity 0.3s, transform 0.3s';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.97)';
          setTimeout(function() { card.remove(); }, 320);
        }

        var total = document.querySelectorAll('#solicitudes-lista [data-id]').length - 1;
        var counter = document.querySelector('header p.text-on-surface-variant');
        if (counter) {
          counter.textContent = total + ' solicitud' + (total !== 1 ? 'es' : '') + ' esperando tu respuesta';
        }

      } catch (err) {
        errorDiv.classList.remove('hidden');
        errorText.textContent = 'Error al enviar: ' + (err.message || 'desconocido');
        btns.forEach(function(b) { b.disabled = false; });
      }
    });
  });
</script>
<style>
  @keyframes spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
</style>