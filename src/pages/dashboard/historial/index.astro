---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL;

// 1. Auth guard estandarizado y seguro
const proveedorId = 
  Astro.cookies.get('id_mayorista')?.value ?? 
  Astro.cookies.get('proveedor_id')?.value;

if (!proveedorId || proveedorId === 'undefined' || proveedorId === 'null') {
  return Astro.redirect('/login'); // Redirigimos al login
}

// Helper fetch seguro
async function safeFetch(url: string) {
  try {
    const res  = await fetch(url);
    const text = await res.text();
    if (!text || text.trim() === '') return { success: false, data: null, pagination: null };
    return JSON.parse(text);
  } catch (e) {
    return { success: false, data: null, pagination: null };
  }
}

// 2. Fetch seguro garantizado porque proveedorId ya es un Guid válido
const result = await safeFetch(
  `${API_URL}/api/solicitudes-mayorista?id_mayorista=${proveedorId}&estado=aceptada,rechazada&pageSize=100`
);
const historial: any[] = result.data ?? [];

const totalAceptadas  = historial.filter((s: any) => s.estado === 'aceptada').length;
const totalRechazadas = historial.filter((s: any) => s.estado === 'rechazada').length;
const total           = totalAceptadas + totalRechazadas;
const tasaAceptacion  = total > 0 ? Math.round((totalAceptadas / total) * 100) : 0;

const estadoBadge: Record<string, { classes: string; label: string; icon: string }> = {
  aceptada:  { classes: 'bg-success/10 text-success border-success/20',   label: 'Aceptada',  icon: 'check_circle' },
  rechazada: { classes: 'bg-error/10 text-error border-error/20',         label: 'Rechazada', icon: 'cancel'       },
};
---

<DashboardLayout title="Historial de Solicitudes" activeNav="historial">

  <!-- Header -->
  <header class="mb-8">
    <p class="text-sm font-semibold text-primary uppercase tracking-widest mb-2">Actividad Reciente</p>
    <h1 class="font-headline text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight">
      Historial de Solicitudes
    </h1>
    <p class="text-on-surface-variant font-body mt-1">
      Solicitudes que han sido respondidas por ti
    </p>
  </header>

  <!-- KPIs -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="glass-card rounded-2xl p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-success/10 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-success text-2xl">check_circle</span>
      </div>
      <div>
        <p class="text-xs text-on-surface-variant uppercase tracking-widest">Aceptadas</p>
        <p class="text-2xl font-bold text-on-surface">{totalAceptadas}</p>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-error/10 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-error text-2xl">cancel</span>
      </div>
      <div>
        <p class="text-xs text-on-surface-variant uppercase tracking-widest">Rechazadas</p>
        <p class="text-2xl font-bold text-on-surface">{totalRechazadas}</p>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5 flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-primary text-2xl">analytics</span>
      </div>
      <div>
        <p class="text-xs text-on-surface-variant uppercase tracking-widest">Tasa de Aceptación</p>
        <p class="text-2xl font-bold text-on-surface">{tasaAceptacion}%</p>
      </div>
    </div>
  </div>

  <!-- Filtros de estado -->
  <div class="flex gap-2 mb-6 overflow-x-auto pb-2 scrollbar-hide" id="filtros-estado">
    <button data-filter="all"       class="estado-filter active shrink-0 px-4 py-2 rounded-xl text-sm font-semibold bg-primary/10 text-primary border border-primary/20 transition-smooth">
      Todas ({total})
    </button>
    <button data-filter="aceptada"  class="estado-filter shrink-0 px-4 py-2 rounded-xl text-sm font-medium text-on-surface-variant bg-surface-container border border-outline-subtle hover:border-success/20 hover:text-success transition-smooth">
      Aceptadas ({totalAceptadas})
    </button>
    <button data-filter="rechazada" class="estado-filter shrink-0 px-4 py-2 rounded-xl text-sm font-medium text-on-surface-variant bg-surface-container border border-outline-subtle hover:border-error/20 hover:text-error transition-smooth">
      Rechazadas ({totalRechazadas})
    </button>
  </div>

  <!-- Lista de solicitudes -->
  {historial.length === 0 ? (
    <div class="glass-card rounded-2xl p-16 text-center">
      <span class="material-symbols-outlined text-6xl text-on-surface-variant mb-4">history</span>
      <h3 class="text-xl font-bold text-on-surface mb-2">Sin historial</h3>
      <p class="text-on-surface-variant">Tus solicitudes respondidas aparecerán aquí.</p>
    </div>
  ) : (
    <div class="flex flex-col gap-3" id="historial-lista">
      {historial.map((sol: any) => {
        const badge    = estadoBadge[sol.estado] ?? estadoBadge.aceptada;
        const productos = Array.isArray(sol.productos) ? sol.productos : [];
        const fecha    = sol.respondido_at
          ? new Date(sol.respondido_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' })
          : new Date(sol.created_at).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });

        return (
          <div
            class="historial-card glass-card rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center gap-4 transition-smooth hover-glow"
            data-estado={sol.estado}
          >
            <!-- Ícono estado -->
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center shrink-0 ${badge.classes.replace('text-', 'bg-').replace('border-', '')} bg-opacity-10`}>
              <span class={`material-symbols-outlined text-2xl ${badge.classes.split(' ').find(c => c.startsWith('text-'))}`}>
                {badge.icon}
              </span>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold border ${badge.classes}`}>
                  <span class="material-symbols-outlined text-xs">{badge.icon}</span>
                  {badge.label}
                </span>
                <span class="text-xs text-on-surface-variant">{fecha}</span>
              </div>

              <!-- Productos de la solicitud -->
              {productos.length > 0 ? (
                <div class="flex flex-wrap gap-1 mt-1">
                  {productos.map((p: any) => (
                    <span class="px-2 py-0.5 rounded-lg bg-surface-container border border-outline-subtle text-xs text-on-surface">
                      {typeof p === 'string' ? p : (p.nombre ?? p.nombre_articulo ?? 'Producto')}
                      {p.cantidad ? ` ×${p.cantidad}` : ''}
                    </span>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-on-surface-variant mt-1">Sin detalle de productos</p>
              )}

              {sol.notas_mayorista && (
                <p class="text-xs text-on-surface-variant mt-2 italic">
                  Tu nota: {sol.notas_mayorista}
                </p>
              )}
            </div>

            <!-- Fecha desktop -->
            <div class="hidden sm:flex flex-col items-end shrink-0">
              <span class="text-xs text-on-surface-variant">{fecha}</span>
            </div>
          </div>
        );
      })}
    </div>
  )}
</DashboardLayout>

<script is:inline>
  // Filtro por estado en cliente
  document.querySelectorAll('.estado-filter').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.estado-filter').forEach(function(b) {
        b.classList.remove('bg-primary/10', 'text-primary', 'border-primary/20');
        b.classList.add('bg-surface-container', 'text-on-surface-variant', 'border-outline-subtle');
      });
      btn.classList.remove('bg-surface-container', 'text-on-surface-variant', 'border-outline-subtle');
      btn.classList.add('bg-primary/10', 'text-primary', 'border-primary/20');

      var filter = btn.dataset.filter;
      document.querySelectorAll('.historial-card').forEach(function(card) {
        card.style.display = (filter === 'all' || card.dataset.estado === filter) ? '' : 'none';
      });
    });
  });
</script>