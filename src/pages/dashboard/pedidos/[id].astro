---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { pedidos } from '../../../data/pedidos';

export function getStaticPaths() {
  return pedidos.map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const pedido = pedidos.find(p => p.id === id)!;

const estadoColor: Record<string, string> = {
  pendiente:  'bg-secondary-container text-on-secondary-container',
  confirmado: 'bg-primary-fixed text-primary',
  rechazado:  'bg-error-container text-on-error-container',
  enviado:    'bg-secondary-container text-secondary',
};
const estadoLabel: Record<string, string> = {
  pendiente: 'Pendiente',
  confirmado: 'Confirmado',
  rechazado: 'Rechazado',
  enviado: 'Enviado',
};
---

<DashboardLayout title={`Pedido ${pedido.numero}`} activeNav="pedidos">
  <div class="max-w-5xl mx-auto">

    <!-- Back + Header -->
    <div class="mb-8">
      <a href="/dashboard/pedidos" class="flex items-center gap-2 text-secondary text-sm font-semibold hover:underline mb-4">
        <span class="material-symbols-outlined text-sm">arrow_back</span>
        Volver a Pedidos
      </a>
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <h1 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface tracking-tighter mb-2">
            {pedido.numero}
          </h1>
          <p class="text-on-surface-variant font-body">
            Solicitud de <span class="font-semibold text-on-surface">{pedido.empresa}</span> · {pedido.fecha}
          </p>
        </div>
        <span class={`px-4 py-2 rounded-full text-sm font-bold uppercase tracking-wide ${estadoColor[pedido.estado]}`}>
          {estadoLabel[pedido.estado]}
        </span>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- Main: Products + Actions -->
      <div class="lg:col-span-8 space-y-6">

        <!-- Products -->
        <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm">
          <h2 class="text-xl font-bold mb-6 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">inventory_2</span>
            Artículos del Pedido
          </h2>
          <div class="space-y-4">
            {pedido.productos.map(prod => (
              <div class="flex items-center justify-between py-4 border-b border-outline-variant/15 last:border-0">
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 bg-surface-container-high rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-outline">package_2</span>
                  </div>
                  <div>
                    <p class="font-semibold text-on-surface text-sm">{prod.nombre}</p>
                    <p class="text-xs text-on-surface-variant">SKU: {prod.sku}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="text-sm font-bold text-on-surface">${(prod.precio * prod.cantidad).toLocaleString('es-MX', { minimumFractionDigits: 2 })}</p>
                  <p class="text-xs text-on-surface-variant">{prod.cantidad} uds. × ${prod.precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Total -->
          <div class="pt-4 mt-2 flex justify-between items-center">
            <span class="text-on-surface-variant text-sm">{pedido.productos.reduce((s, p) => s + p.cantidad, 0)} artículos en total</span>
            <span class="text-xl font-bold text-primary">
              Total: ${pedido.total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
            </span>
          </div>
        </div>

        <!-- Notes -->
        {pedido.notas && (
          <div class="bg-surface-container-low rounded-xl p-6">
            <h3 class="font-bold text-on-surface mb-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-outline text-sm">sticky_note_2</span>
              Notas del Operador
            </h3>
            <p class="text-sm text-on-surface-variant leading-relaxed">{pedido.notas}</p>
          </div>
        )}

        <!-- Action Buttons (only for pending orders) -->
        {pedido.estado === 'pendiente' && (
          <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm">
            <h2 class="text-xl font-bold mb-2 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">gavel</span>
              Decisión del Pedido
            </h2>
            <p class="text-on-surface-variant text-sm mb-6">
              Revisa los detalles del pedido y toma una decisión. Esta acción notificará al operador.
            </p>

            <!-- Reject reason (hidden by default) -->
            <div id="reject-form" class="hidden mb-6">
              <label class="block text-sm font-semibold text-on-surface-variant mb-2">Motivo del Rechazo</label>
              <textarea
                id="reject-reason"
                rows="3"
                placeholder="Escribe el motivo por el cual se rechaza el pedido..."
                class="w-full px-4 py-3 bg-surface-container-high border-none rounded-xl focus:ring-2 focus:ring-error/40 text-on-surface text-sm placeholder:text-outline/60 resize-none"
              ></textarea>
            </div>

            <div class="flex gap-4 flex-wrap">
              <button
                id="btn-reject"
                class="flex-1 min-w-[160px] flex items-center justify-center gap-2 py-4 px-6 rounded-xl border-2 border-error text-error font-bold hover:bg-error-container transition-all"
              >
                <span class="material-symbols-outlined">cancel</span>
                Rechazar Pedido
              </button>
              <a
                href={`/dashboard/despacho/${pedido.id}`}
                class="flex-1 min-w-[160px] flex items-center justify-center gap-2 py-4 px-6 rounded-xl bg-gradient-to-br from-primary to-primary-container text-on-primary font-bold shadow-lg hover:opacity-90 active:scale-[0.98] transition-all"
              >
                <span class="material-symbols-outlined">check_circle</span>
                Confirmar y Proceder
              </a>
            </div>
          </div>
        )}

        <!-- Confirmed/Shipped state -->
        {pedido.estado === 'confirmado' && (
          <div class="bg-primary-fixed rounded-xl p-6 flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined text-white">check_circle</span>
              </div>
              <div>
                <p class="font-bold text-primary">Pedido Confirmado</p>
                <p class="text-sm text-on-surface-variant">Listo para asignar despacho</p>
              </div>
            </div>
            <a
              href={`/dashboard/despacho/${pedido.id}`}
              class="flex items-center gap-2 py-3 px-6 rounded-xl bg-primary text-on-primary font-bold hover:opacity-90 transition-all"
            >
              <span class="material-symbols-outlined">local_shipping</span>
              Ir a Despacho
            </a>
          </div>
        )}

        <!-- Rejected state -->
        {pedido.estado === 'rechazado' && (
          <div class="bg-error-container rounded-xl p-6 flex items-center gap-4">
            <span class="material-symbols-outlined text-error text-3xl">cancel</span>
            <div>
              <p class="font-bold text-on-error-container">Pedido Rechazado</p>
              <p class="text-sm text-on-surface-variant">Este pedido fue rechazado y el operador fue notificado.</p>
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar: Client info + Summary -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Client Card -->
        <div class="bg-surface-container-low rounded-xl p-6">
          <h3 class="font-bold text-on-surface mb-4 border-b border-outline-variant/15 pb-2">
            Datos del Cliente
          </h3>
          <div class="space-y-4">
            <div>
              <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wide mb-1">Empresa</p>
              <p class="text-sm font-medium text-on-surface">{pedido.empresa}</p>
            </div>
            <div>
              <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wide mb-1">Contacto</p>
              <p class="text-sm text-on-surface">{pedido.cliente}</p>
            </div>
            <div>
              <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wide mb-1">Email</p>
              <p class="text-sm text-on-surface">{pedido.email}</p>
            </div>
            <div>
              <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wide mb-1">Teléfono</p>
              <p class="text-sm text-on-surface">{pedido.telefono}</p>
            </div>
            <div>
              <p class="text-xs text-on-surface-variant font-semibold uppercase tracking-wide mb-1">Dirección de Entrega</p>
              <p class="text-sm text-on-surface leading-relaxed">{pedido.direccion}</p>
            </div>
          </div>
        </div>

        <!-- Order Summary -->
        <div class="bg-surface-container-low rounded-xl p-6">
          <h3 class="font-bold text-on-surface mb-4 border-b border-outline-variant/15 pb-2">
            Resumen Financiero
          </h3>
          <div class="space-y-3">
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Subtotal</span>
              <span class="font-medium">${pedido.subtotal.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-on-surface-variant">Envío</span>
              <span class="font-medium text-secondary">Incluido</span>
            </div>
            <div class="pt-3 border-t border-outline-variant/15 flex justify-between">
              <span class="font-bold text-on-surface">Total</span>
              <span class="font-bold text-lg text-primary">
                ${pedido.total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
              </span>
            </div>
          </div>
        </div>

        {pedido.guia && (
          <div class="bg-secondary-container rounded-xl p-6">
            <p class="text-xs font-semibold text-on-secondary-container uppercase tracking-wide mb-2">Número de Guía</p>
            <p class="font-bold text-on-secondary-container text-lg">{pedido.guia}</p>
            <p class="text-sm text-on-surface-variant mt-1">{pedido.transportista}</p>
          </div>
        )}
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  const btnReject = document.getElementById('btn-reject');
  const rejectForm = document.getElementById('reject-form');
  let rejectVisible = false;

  btnReject?.addEventListener('click', () => {
    if (!rejectVisible) {
      rejectForm?.classList.remove('hidden');
      btnReject.textContent = '';
      btnReject.innerHTML = '<span class="material-symbols-outlined">send</span> Confirmar Rechazo';
      rejectVisible = true;
    } else {
      // Simulate reject and redirect
      window.location.href = '/dashboard/pedidos';
    }
  });
</script>
