---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { pedidos } from '../../../data/pedidos';

const estadoBadge: Record<string, { bg: string; text: string; label: string; dot: string }> = {
  pendiente:  { bg: 'bg-secondary-container', text: 'text-on-secondary-container', label: 'Pendiente',   dot: 'bg-secondary'  },
  confirmado: { bg: 'bg-primary-fixed',        text: 'text-primary',                label: 'Confirmado',  dot: 'bg-primary'    },
  rechazado:  { bg: 'bg-error-container',      text: 'text-on-error-container',     label: 'Rechazado',   dot: 'bg-error'      },
  enviado:    { bg: 'bg-secondary-container',  text: 'text-secondary',              label: 'Enviado',     dot: 'bg-secondary'  },
};
---

<DashboardLayout title="Pedidos" activeNav="pedidos">
  <!-- Header -->
  <div class="mb-8 flex items-start justify-between">
    <div>
      <h1 class="font-headline text-4xl md:text-5xl font-extrabold text-on-surface tracking-tighter mb-2">
        Solicitudes de Pedido
      </h1>
      <p class="text-on-surface-variant font-body">
        Revisa y gestiona las solicitudes enviadas por los operadores.
      </p>
    </div>
    <div class="flex items-center gap-3 mt-2">
      <span class="text-sm text-on-surface-variant">{pedidos.length} pedidos en total</span>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div class="flex gap-2 mb-6 flex-wrap">
    {(['Todos', 'Pendiente', 'Confirmado', 'Rechazado'] as const).map((tab) => (
      <button
        data-filter={tab === 'Todos' ? 'all' : tab.toLowerCase()}
        class="filter-btn px-4 py-2 rounded-full text-sm font-semibold transition-all"
      >
        {tab}
      </button>
    ))}
  </div>

  <!-- Orders Table -->
  <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-outline-variant/20">
            <th class="text-left px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Pedido</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Cliente / Empresa</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Fecha</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Total</th>
            <th class="text-left px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Estado</th>
            <th class="text-right px-6 py-4 text-xs font-semibold text-on-surface-variant uppercase tracking-widest">Acción</th>
          </tr>
        </thead>
        <tbody id="orders-body" class="divide-y divide-outline-variant/10">
          {pedidos.map((pedido) => {
            const badge = estadoBadge[pedido.estado];
            return (
              <tr
                class="hover:bg-surface-container-low transition-colors"
                data-estado={pedido.estado}
              >
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-surface-container-low rounded-lg flex items-center justify-center">
                      <span class="material-symbols-outlined text-sm text-outline">shopping_cart</span>
                    </div>
                    <span class="font-semibold text-on-surface text-sm">{pedido.numero}</span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <p class="text-sm font-medium text-on-surface">{pedido.cliente}</p>
                  <p class="text-xs text-on-surface-variant">{pedido.empresa}</p>
                </td>
                <td class="px-6 py-4 text-sm text-on-surface-variant">{pedido.fecha}</td>
                <td class="px-6 py-4 text-sm font-semibold text-on-surface">
                  ${pedido.total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}
                </td>
                <td class="px-6 py-4">
                  <span class={`inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1 rounded-full ${badge.bg} ${badge.text}`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${badge.dot}`}></span>
                    {badge.label}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  {pedido.estado === 'pendiente' ? (
                    <a
                      href={`/dashboard/pedidos/${pedido.id}`}
                      class="inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"
                    >
                      Revisar
                      <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                  ) : pedido.estado === 'confirmado' ? (
                    <a
                      href={`/dashboard/despacho/${pedido.id}`}
                      class="inline-flex items-center gap-1 text-sm font-semibold text-secondary hover:underline"
                    >
                      Despachar
                      <span class="material-symbols-outlined text-sm">local_shipping</span>
                    </a>
                  ) : (
                    <a
                      href={`/dashboard/pedidos/${pedido.id}`}
                      class="inline-flex items-center gap-1 text-sm text-outline hover:text-on-surface transition-colors"
                    >
                      Ver detalle
                      <span class="material-symbols-outlined text-sm">chevron_right</span>
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLTableRowElement>('#orders-body tr');

  function setActive(btn: HTMLButtonElement) {
    filterBtns.forEach(b => {
      b.classList.remove('bg-primary', 'text-white');
      b.classList.add('bg-surface-container-low', 'text-on-surface-variant');
    });
    btn.classList.add('bg-primary', 'text-white');
    btn.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
  }

  filterBtns.forEach(btn => {
    // Set default style
    btn.classList.add('bg-surface-container-low', 'text-on-surface-variant');

    btn.addEventListener('click', () => {
      setActive(btn);
      const filter = btn.dataset.filter!;
      rows.forEach(row => {
        const estado = row.dataset.estado!;
        row.style.display = (filter === 'all' || estado === filter) ? '' : 'none';
      });
    });
  });

  // Set "Todos" active by default
  const allBtn = document.querySelector<HTMLButtonElement>('[data-filter="all"]');
  if (allBtn) setActive(allBtn);
</script>
